# Server-only (recommended for Vercel). Do not use NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron が付与する Bearer トークンと一致させる（本番の90日削除用）
CRON_SECRET=

# 公開URL（sitemap / OGP 用）
NEXT_PUBLIC_SITE_URL=https://warikan-app-umber.vercel.app

# 公開してよい連絡先（フッター・プライバシー・About に表示）
NEXT_PUBLIC_CONTACT_EMAIL=

# 任意: アプリ内「コーヒーをおごる」（ゲスト・円・カード / Google Pay / Apple Pay）
# Stripe ダッシュボードで日本円・ウォレットを有効化し、本番ドメインを Apple Pay に登録
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_DONATE_LABEL=コーヒーをおごる

# 任意: Stripe 未設定時の外部支援ページ（どちらかあればフッターにボタン表示）
NEXT_PUBLIC_DONATE_URL=
